# AQ O&M Platform — environment variables (NAMES ONLY, no values here).
# Copy to .env and fill in locally. .env is gitignored and must never be committed.

# --- Database ---
# PostgreSQL/TimescaleDB DSN, e.g. postgresql+asyncpg://user:pass@host:5432/aq_om
DATABASE_URL=
# Used by docker-compose.yml for the local TimescaleDB container
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- FusionSolar adapter ---
# "mock" (default, safe everywhere) or "real" (staging/prod scheduler only)
FUSIONSOLAR_MODE=
FUSIONSOLAR_BASE_URL=
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_PASSWORD=

# --- Ingestion scheduler ---
# "true" to run the ingestion loop inside the API process
SCHEDULER_ENABLED=
# Seconds between ingestion cycles (respect the FusionSolar rate limit!)
SCHEDULER_INTERVAL_SECONDS=

# --- Frontend ---
# Base URL of the backend API as seen from the browser
NEXT_PUBLIC_API_BASE_URL=
