# AQ O&M Platform — environment variables (NAMES ONLY, no values here).
# Copy to .env and fill in locally. .env is gitignored and must never be committed.

# --- Database ---
# PostgreSQL/TimescaleDB DSN, e.g. postgresql+asyncpg://user:pass@host:5432/aq_om
DATABASE_URL=
# Used by docker-compose.yml for the local TimescaleDB container
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- FusionSolar adapter ---
# "mock" (default, safe everywhere) or "real" (blocked with the scheduler
# until PR-2 Raw/Quarantine exists)
FUSIONSOLAR_MODE=
# API contract profile; PR-1 supports exactly: legacy_system_code
FUSIONSOLAR_API_PROFILE=
# https://<your-portal-host>/thirdData (HTTPS only, no credentials in URL)
FUSIONSOLAR_BASE_URL=
FUSIONSOLAR_USERNAME=
# Canonical credential (Huawei "systemCode" — a dedicated API credential)
FUSIONSOLAR_SYSTEM_CODE=
# DEPRECATED alias of FUSIONSOLAR_SYSTEM_CODE (do not set both)
FUSIONSOLAR_PASSWORD=

# --- FusionSolar rate budgets (safety defaults; see docs/FUSIONSOLAR-CONTRACT.md) ---
FUSIONSOLAR_LOGIN_MAX_CALLS=
FUSIONSOLAR_LOGIN_WINDOW_SECONDS=
FUSIONSOLAR_STATION_LIST_MAX_CALLS=
FUSIONSOLAR_STATION_LIST_WINDOW_SECONDS=
FUSIONSOLAR_KPI_WINDOW_SECONDS=
FUSIONSOLAR_KPI_MARGIN_SECONDS=
FUSIONSOLAR_STATION_LIST_MAX_PAGES=
# Station inventory refresh cadence (default: 6 hours)
FUSIONSOLAR_INVENTORY_REFRESH_SECONDS=

# --- Ingestion scheduler ---
# "true" to run the ingestion loop inside the API process
SCHEDULER_ENABLED=
# Seconds between KPI cycles (respect the FusionSolar rate limits!)
SCHEDULER_INTERVAL_SECONDS=

# --- Frontend ---
# Base URL of the backend API as seen from the browser
NEXT_PUBLIC_API_BASE_URL=
